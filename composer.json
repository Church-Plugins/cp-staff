{
  "name": "churchplugins/cp-staff",
  "type": "wordpress-plugin",
  "description": "Church staff plugin.",
  "keywords": [],
  "homepage": "https://churchplugins.com",
  "authors": [
    {
      "name": "Tanner Moushey",
      "email": "tanner@churchplugins.com",
      "homepage": "https://churchplugins.com"
    }
  ],
  "require": {
    "php": ">=5.3.0",
    "composer/installers": "*",
    "wpackio/enqueue": "^3.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "autoload": {
    "psr-4": {
      "CP_Staff\\": "includes/"
    }
  }
}
